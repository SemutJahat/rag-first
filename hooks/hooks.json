{
  "description": "rag-first: search the project's enowx-rag RAG before grepping or reading around",
  "modules": [
    "./register.ts"
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/gate.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Grep|Glob|Read|Bash|mcp__enowx-rag__rag_semantic_search|mcp__enowx-rag__rag_retrieve_context|mcp__enowx-rag__rag_index_project",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/gate.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__enowx-rag__rag_semantic_search|mcp__enowx-rag__rag_retrieve_context|mcp__enowx-rag__rag_index_project|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/gate.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__enowx-rag__rag_semantic_search|mcp__enowx-rag__rag_retrieve_context|mcp__enowx-rag__rag_index_project",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/gate.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "mcp__enowx-rag__rag_semantic_search|mcp__enowx-rag__rag_retrieve_context|mcp__enowx-rag__rag_index_project",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/gate.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
